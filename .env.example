# Neon（Vercel の Storage → Neon で接続すると自動で入る）
DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# マイグレーション用（任意。なければ DATABASE_URL を使う）
DATABASE_URL_UNPOOLED=

# ログインセッションの署名キー（32 文字以上: openssl rand -hex 32）
SESSION_SECRET=

# Vercel Cron の認証（openssl rand -hex 32）
CRON_SECRET=

# 価格データ（任意）
COINGECKO_API_KEY=
STOCK_PRICE_PROVIDER=finnhub
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
