{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "pdx1"
  ],
  "crons": [
    {
      "path": "/api/cron/daily?slot=pdt",
      "schedule": "30 13 * * *"
    },
    {
      "path": "/api/cron/daily?slot=pst",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/cron/news?slot=morning",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/news?slot=noon",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/news?slot=evening",
      "schedule": "0 1 * * *"
    }
  ]
}
